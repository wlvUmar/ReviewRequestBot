# ReviewRequestBot .env.example
# Copy to .env and fill in secrets before running the bot

# Telegram
BOT_TOKEN=your_telegram_bot_token_here

# PHP Backend
PHP_API_BASE_URL=https://your-php-site.com/api
PHP_API_SECRET=changeme_bot_api_secret

# Callback server (Flask) — where the PHP backend will post review results
CALLBACK_HOST=0.0.0.0
CALLBACK_PORT=5055
CALLBACK_SECRET=changeme_callback_secret

# MySQL (used to store bot tables)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_cms_db
DB_USER=root
DB_PASSWORD=

# Behaviour
MAX_RETRIES=3
RETRY_DELAY=2.0
IMAGE_MAX_MB=10
MAX_PHOTOS_PER_REQUEST=4
NOTIFY_POLL_INTERVAL=60

# Redis (user state). Locally use host/port; on Railway set REDIS_URL to the Redis service reference instead.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://default:password@host:6379

# Telegram ids (comma-separated) of the people who get new-request alerts
ADMIN_IDS=

# Optional: LLM pricing helper (separate "pricer" service, see README)
OPENROUTER_API_KEY=
PRICER_URL=http://localhost:8001

# Set automatically by Railway; the webhook server listens on it. Leave unset locally (CALLBACK_PORT is used).
# PORT=